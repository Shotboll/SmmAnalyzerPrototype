@using SmmAnalyzerPrototype.Data.Models.DTO.Community
@model List<CommunityDto>

@{
    ViewData["Title"] = "Сообщества";
}

<div class="communities-list-page">
    <div class="communities-list-header">
        <div>
            <h1 class="communities-list-title">Сообщества</h1>
            <p class="communities-list-subtitle">Управление аудиторией, стилем общения и подключением к VK.</p>
        </div>

        <a asp-action="Create" class="communities-list-create-btn">
            <span>＋</span>
            <span>Создать сообщество</span>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="communities-list-empty">
            <div class="communities-list-empty-icon">👥</div>
            <h3>Сообществ пока нет</h3>
            <p>Создайте первое сообщество, чтобы задавать аудиторию, стиль общения и анализировать публикации.</p>

            <a asp-action="Create" class="communities-list-create-btn">
                <span>＋</span>
                <span>Создать сообщество</span>
            </a>
        </div>
    }
    else
    {
        <div class="communities-list">
            @foreach (var item in Model)
            {
                <div class="community-list-item">
                    <div class="community-list-main">
                        <div class="community-list-avatar">
                            @GetCommunityInitials(item.Name)
                        </div>

                        <div class="community-list-content">
                            <div class="community-list-top">
                                <h2 class="community-list-name">@item.Name</h2>

                                @if (!string.IsNullOrWhiteSpace(item.StyleProfile))
                                {
                                    <span class="community-list-style">@item.StyleProfile</span>
                                }
                                else
                                {
                                    <span class="community-list-muted-chip">Стиль не указан</span>
                                }
                            </div>

                            <div class="community-list-meta">
                                <div>
                                    <span class="community-list-label">Аудитория:</span>
                                    @if (!string.IsNullOrWhiteSpace(item.TargetAudience))
                                    {
                                        <span>@item.TargetAudience</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">не указана</span>
                                    }
                                </div>

                                <div>
                                    <span class="community-list-label">VK:</span>
                                    @if (!string.IsNullOrWhiteSpace(item.VkUrl))
                                    {
                                        <a href="@item.VkUrl" target="_blank" class="community-list-vk">
                                            @(!string.IsNullOrWhiteSpace(item.VkScreenName) ? item.VkScreenName : item.VkUrl)
                                        </a>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(item.VkInput))
                                    {
                                        <span>@item.VkInput</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">не подключён</span>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="community-list-actions">
                        <a asp-action="Edit" asp-route-id="@item.Id" class="community-list-btn community-list-edit">
                            Редактировать
                        </a>

                        <a asp-action="Delete" asp-route-id="@item.Id" class="community-list-btn community-list-delete">
                            Удалить
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    private string GetCommunityInitials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name))
            return "С";

        var words = name
            .Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Take(2)
            .ToList();

        if (words.Count == 0)
            return "С";

        return string.Join("", words.Select(x => x[0])).ToUpperInvariant();
    }
}