@model StyleCheckPageModel

@{
    ViewData["Title"] = "Проверка стиля";

    var hasResult = Model.Result != null;
    var assessmentText = hasResult
    ? NormalizeAssessmentText(Model.Result!.Assessment)
    : "Проверка не выполнена";
}

<div class="style-check-page">
    <div class="style-check-header">
        <div>
            <h1 class="style-check-title">Проверка стиля</h1>
            <p class="style-check-subtitle">
                Анализ соответствия текста целевой аудитории и стилю выбранного сообщества.
            </p>
        </div>

        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="style-check-back-top-btn">
            ← Назад к посту
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            @Model.ErrorMessage
        </div>
    }

    <div class="style-check-layout">
        <section class="style-check-post-card">
            <div class="style-check-card-head">
                <div>
                    <div class="style-check-label">Сообщество</div>
                    <div class="style-check-community">@Model.CommunityName</div>
                </div>

                <span class="style-check-status @GetAssessmentCssClass(assessmentText)">
                    @assessmentText
                </span>
            </div>

            <div class="style-check-label mb-2">Текст поста</div>
            <div class="style-check-post-text">@Model.Text</div>

            <form asp-action="Style" method="post" id="styleCheckForm" class="style-check-actions">
                @Html.AntiForgeryToken()
                <input asp-for="PostId" type="hidden" />

                <button type="submit" class="style-check-primary-btn" id="submitBtn">
                    Проверить стиль
                </button>

                <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="style-check-secondary-btn">
                    Назад к посту
                </a>
            </form>
        </section>

        <section class="style-check-result-card">
            <div class="style-check-result-head">
                <div>
                    <h2>Результат анализа</h2>
                    <p>Оценка того, насколько текст подходит под аудиторию и стиль сообщества.</p>
                </div>

                <span class="style-check-result-badge @GetAssessmentCssClass(assessmentText)">
                    @assessmentText
                </span>
            </div>

            @if (Model.Result != null)
            {
                <div class="style-check-summary-box">
                    <div class="style-check-summary-title">Общий вывод</div>
                    <div class="style-check-summary-text">@Model.Result.Summary</div>
                </div>

                <div class="style-check-result-grid">
                    <div class="style-check-info-card strengths">
                        <div class="style-check-info-head">
                            <div class="style-check-info-icon">✓</div>
                            <h3>Сильные стороны</h3>
                        </div>

                        @if (Model.Result.Strengths.Any())
                        {
                            <ul class="style-check-list">
                                @foreach (var item in Model.Result.Strengths)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="style-check-empty-text">Сильные стороны не выделены.</div>
                        }
                    </div>

                    <div class="style-check-info-card issues">
                        <div class="style-check-info-head">
                            <div class="style-check-info-icon">!</div>
                            <h3>Что можно улучшить</h3>
                        </div>

                        @if (Model.Result.Issues.Any())
                        {
                            <ul class="style-check-list">
                                @foreach (var item in Model.Result.Issues)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="style-check-empty-text">Явных проблем не найдено.</div>
                        }
                    </div>
                </div>

                <div class="style-check-recommendations-card">
                    <div class="style-check-info-head">
                        <div class="style-check-info-icon">💡</div>
                        <h3>Рекомендации</h3>
                    </div>

                    @if (Model.Result.Recommendations.Any())
                    {
                        <ol class="style-check-recommendations-list">
                            @foreach (var item in Model.Result.Recommendations)
                            {
                                <li>@item</li>
                            }
                        </ol>
                    }
                    else
                    {
                        <div class="style-check-empty-text">Рекомендации не были сформированы.</div>
                    }
                </div>
            }
            else
            {
                <div class="style-check-no-result">
                    <div class="style-check-no-result-icon">🎯</div>
                    <div>
                        <div class="style-check-no-result-title">Результата пока нет</div>
                        <div class="style-check-no-result-text">
                            Запустите анализ, чтобы получить оценку стиля, сильные стороны и рекомендации.
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@await Html.PartialAsync("_LoadingOverlay", new RAGTEST.Models.LoadingOverlayViewModel
{
    OverlayId = "styleLoadingOverlay",
    MessageId = "styleLoadingMessage",
    Title = "Идёт проверка стиля",
    InitialMessage = "Анализируем соответствие текста аудитории и стилю сообщества...",
    Hint = "Проверка может занять некоторое время, так как используется локальная модель."
})

@section Scripts {
    <script>
        initLoadingForm({
            formId: "styleCheckForm",
            submitButtonId: "submitBtn",
            overlayId: "styleLoadingOverlay",
            messageId: "styleLoadingMessage",
            submitText: "Проверить стиль",
            loadingButtonText: "Проверка...",
            messages: [
                "Анализируем соответствие текста аудитории и стилю сообщества...",
                "Извлекаем параметры выбранного сообщества...",
                "Оцениваем тон, лексику и подачу текста...",
                "Формируем сильные стороны и замечания...",
                "Подготавливаем рекомендации...",
                "Почти готово..."
            ]
        });
    </script>
}

@functions {
    private string GetAssessmentCssClass(string? assessment)
    {
        if (string.IsNullOrWhiteSpace(assessment))
            return "pending";

        var value = assessment.Trim().ToLowerInvariant();

        if (value == "соответствует")
            return "success";

        if (value == "частично соответствует")
            return "warning";

        if (value == "не соответствует")
            return "danger";

        return "pending";
    }

    private string NormalizeAssessmentText(string? assessment)
    {
        if (string.IsNullOrWhiteSpace(assessment))
            return "Проверка не выполнена";

        return assessment.Trim() switch
        {
            "соответствует" => "Соответствует",
            "частично соответствует" => "Частично соответствует",
            "не соответствует" => "Не соответствует",
            _ => assessment.Trim()
        };
    }
}