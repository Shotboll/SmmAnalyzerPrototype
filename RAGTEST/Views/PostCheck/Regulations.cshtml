@model RAGTEST.Models.RegulationCheckPageModel

@{
    ViewData["Title"] = "Проверка по регламентам";

    var violationsCount = Model.Violations?.Count ?? 0;
    var resultText = Model.HasResult
        ? (Model.HasViolations ? "Обнаружены нарушения" : "Нарушений не найдено")
        : "Проверка не выполнена";
}

<div class="regulation-check-page">
    <div class="regulation-check-header">
        <div>
            <h1 class="regulation-check-title">Проверка по регламентам</h1>
            <p class="regulation-check-subtitle">
                Анализ текста публикации на соответствие правилам выбранного сообщества.
            </p>
        </div>

        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="regulation-check-back-top-btn">
            ← Назад к посту
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            @ViewBag.Error
        </div>
    }

    <div class="regulation-check-layout">
        <section class="regulation-check-post-card">
            <div class="regulation-check-card-head">
                <div>
                    <div class="regulation-check-label">Сообщество</div>
                    <div class="regulation-check-community">@Model.CommunityName</div>
                </div>

                <span class="regulation-check-status @(Model.HasResult ? (Model.HasViolations ? "danger" : "success") : "pending")">
                    @resultText
                </span>
            </div>

            <div class="regulation-check-label mb-2">Текст поста</div>
            <div class="regulation-check-post-text">@Model.Text</div>

            <form asp-action="Regulations" method="post" id="regulationForm" class="regulation-check-actions">
                @Html.AntiForgeryToken()
                <input asp-for="PostId" type="hidden" />

                <button type="submit" class="regulation-check-primary-btn" id="submitBtn">
                    Проверить заново
                </button>

                <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="regulation-check-secondary-btn">
                    Назад к посту
                </a>
            </form>
        </section>

        <section class="regulation-check-result-card">
            <div class="regulation-check-result-head">
                <div>
                    <h2>Результат проверки</h2>
                    <p>Система сравнивает текст публикации с регламентами, привязанными к выбранному сообществу.</p>
                </div>

                <span class="regulation-check-result-badge @(Model.HasResult ? (Model.HasViolations ? "danger" : "success") : "pending")">
                    @resultText
                </span>
            </div>

            @if (Model.HasResult)
            {
                <div class="regulation-summary-grid">
                    <div class="regulation-summary-card @(Model.HasViolations ? "danger" : "success")">
                        <div class="regulation-summary-value">@violationsCount</div>
                        <div class="regulation-summary-title">Найдено нарушений</div>
                        <div class="regulation-summary-text">
                            @(Model.HasViolations ? "Публикация содержит спорные или запрещённые элементы." : "Проверка не выявила нарушений регламентов.")
                        </div>
                    </div>

                    <div class="regulation-summary-card info">
                        <div class="regulation-summary-value">RAG</div>
                        <div class="regulation-summary-title">Метод проверки</div>
                        <div class="regulation-summary-text">
                            Используются релевантные фрагменты регламентов и локальная языковая модель.
                        </div>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Comment))
                {
                    <div class="regulation-comment-box @(Model.HasViolations ? "danger" : "success")">
                        <div class="regulation-comment-title">Общий вывод</div>
                        <div class="regulation-comment-text">@Model.Comment</div>
                    </div>
                }

                @if (Model.Violations.Any())
                {
                    <div class="regulation-violations-section">
                        <div class="regulation-section-head">
                            <div>
                                <h3>Найденные нарушения</h3>
                                <p>Фрагменты поста, которые модель связала с ограничениями из регламентов.</p>
                            </div>

                            <span class="regulation-count-chip danger">@violationsCount</span>
                        </div>

                        <div class="regulation-violations-list">
                            @foreach (var item in Model.Violations)
                            {
                                <article class="regulation-violation-card">
                                    <div class="regulation-violation-top">
                                        <div>
                                            <div class="regulation-violation-label">Тип результата</div>
                                            <div class="regulation-violation-title">Нарушение регламента</div>
                                        </div>

                                        <span class="regulation-violation-status">Нарушение</span>
                                    </div>

                                    <div class="regulation-violation-body">
                                        <div class="regulation-violation-field">
                                            <div class="regulation-violation-field-label">Фрагмент поста</div>
                                            <div class="regulation-violation-fragment">
                                                @(string.IsNullOrWhiteSpace(item.MatchedText) ? "Фрагмент не указан" : item.MatchedText)
                                            </div>
                                        </div>

                                        @if (!string.IsNullOrWhiteSpace(item.Explanation))
                                        {
                                            <div class="regulation-violation-field">
                                                <div class="regulation-violation-field-label">Причина</div>
                                                <div class="regulation-violation-text">@item.Explanation</div>
                                            </div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(item.RuleShort))
                                        {
                                            <div class="regulation-violation-field">
                                                <div class="regulation-violation-field-label">Основание</div>
                                                <div class="regulation-rule-chip">@item.RuleShort</div>
                                            </div>
                                        }
                                    </div>
                                </article>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="regulation-empty-result">
                        <div class="regulation-empty-icon">✓</div>
                        <div>
                            <div class="regulation-empty-title">Нарушений не найдено</div>
                            <div class="regulation-empty-text">Текст не содержит явных нарушений выбранных регламентов.</div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="regulation-no-result">
                    <div class="regulation-empty-icon">📄</div>
                    <div>
                        <div class="regulation-empty-title">Результата пока нет</div>
                        <div class="regulation-empty-text">
                            Запустите проверку, чтобы система сравнила текст с регламентами сообщества.
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@await Html.PartialAsync("_LoadingOverlay", new RAGTEST.Models.LoadingOverlayViewModel
{
    OverlayId = "regulationLoadingOverlay",
    MessageId = "regulationLoadingMessage",
    Title = "Идёт проверка по регламентам",
    InitialMessage = "Выполняется анализ текста и поиск нарушений...",
    Hint = "Проверка может занять некоторое время, так как используется локальная модель."
})

@section Scripts {
    <script>
        initLoadingForm({
            formId: "regulationForm",
            submitButtonId: "submitBtn",
            overlayId: "regulationLoadingOverlay",
            messageId: "regulationLoadingMessage",
            submitText: "Проверить заново",
            loadingButtonText: "Проверка...",
            messages: [
                "Выполняется анализ текста и поиск нарушений...",
                "Извлекаются подходящие регламенты сообщества...",
                "Сравниваем текст поста с найденными правилами...",
                "Формируем итоговый результат проверки...",
                "Почти готово..."
            ]
        });
    </script>
}