@using System.Text.Json
@model RAGTEST.Models.ForecastPageModel

@{
    ViewData["Title"] = "Прогноз вовлеченности";

    var hasResult = Model.Result != null;
    var levelText = hasResult && !string.IsNullOrWhiteSpace(Model.Result!.Level)
        ? NormalizeLevelText(Model.Result.Level)
        : "Прогноз не выполнен";

    var qualityScore = hasResult ? Model.Result!.QualityScore : 0;
    var rawConfidence = hasResult ? Model.Result!.Confidence : 0;
    var confidencePercent = rawConfidence <= 1 ? Math.Round(rawConfidence * 100) : Math.Round(rawConfidence);
    confidencePercent = Math.Clamp(confidencePercent, 0, 100);
}

<div class="forecast-page">
    <div class="forecast-header">
        <div>
            <h1 class="forecast-title">Прогноз вовлеченности</h1>
            <p class="forecast-subtitle">
                Оценка потенциальной реакции аудитории на публикацию с учетом истории сообщества.
            </p>
        </div>

        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="forecast-back-top-btn">
            ← Назад к посту
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger rounded-4 border-0 shadow-sm">
            @Model.ErrorMessage
        </div>
    }

    <div class="forecast-layout">
        <section class="forecast-post-card">
            <div class="forecast-card-head">
                <div>
                    <div class="forecast-label">Сообщество</div>
                    <div class="forecast-community">@Model.CommunityName</div>
                </div>

                <span class="forecast-status @GetLevelCssClass(levelText)">
                    @levelText
                </span>
            </div>

            <div class="forecast-label mb-2">Текст поста</div>
            <div class="forecast-post-text">@Model.Text</div>

            <form asp-action="Forecast" method="post" id="forecastForm" class="forecast-actions">
                @Html.AntiForgeryToken()
                <input type="hidden" name="postId" value="@Model.PostId" />

                <button type="submit" class="forecast-primary-btn" id="submitBtn">
                    @(Model.Result != null ? "Сгенерировать заново" : "Сгенерировать прогноз")
                </button>

                <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="forecast-secondary-btn">
                    Назад к посту
                </a>
            </form>
        </section>

        <section class="forecast-result-card">
            <div class="forecast-result-head">
                <div>
                    <h2>Результат прогноза</h2>
                    <p>Предварительная оценка вовлеченности на основе текста и истории публикаций.</p>
                </div>

                <span class="forecast-result-badge @GetLevelCssClass(levelText)">
                    @levelText
                </span>
            </div>

            @if (Model.Result != null)
            {
                <div class="forecast-score-grid">
                    <div class="forecast-score-card level @GetLevelCssClass(levelText)">
                        <div class="forecast-score-label">Уровень</div>
                        <div class="forecast-score-value">@levelText</div>
                        <div class="forecast-score-text">Общая качественная оценка потенциала публикации.</div>
                    </div>

                    <div class="forecast-score-card">
                        <div class="forecast-score-label">Качество текста</div>
                        <div class="forecast-score-value">@qualityScore/100</div>

                        <div class="forecast-progress">
                            <div class="forecast-progress-fill @GetQualityCssClass(qualityScore)" style="width: @Math.Clamp(qualityScore, 0, 100)%;"></div>
                        </div>
                    </div>

                    <div class="forecast-score-card">
                        <div class="forecast-score-label">Уверенность</div>
                        <div class="forecast-score-value">@confidencePercent%</div>

                        <div class="forecast-progress">
                            <div class="forecast-progress-fill" style="width: @Math.Clamp((int)confidencePercent, 0, 100)%;"></div>
                        </div>
                    </div>
                </div>

                <div class="forecast-summary-box">
                    <div class="forecast-summary-title">Обоснование</div>
                    <div class="forecast-summary-text">@Model.Result.Reasoning</div>
                </div>

                <div class="forecast-metrics-grid">
                    <div class="forecast-metric-card">
                        <div class="forecast-metric-icon">👍</div>
                        <div>
                            <div class="forecast-metric-label">Ожидаемые лайки</div>
                            <div class="forecast-metric-value">@Model.Result.ExpectedLikes</div>
                        </div>
                    </div>

                    <div class="forecast-metric-card">
                        <div class="forecast-metric-icon">💬</div>
                        <div>
                            <div class="forecast-metric-label">Комментарии</div>
                            <div class="forecast-metric-value">@Model.Result.ExpectedComments</div>
                        </div>
                    </div>

                    <div class="forecast-metric-card">
                        <div class="forecast-metric-icon">👁️</div>
                        <div>
                            <div class="forecast-metric-label">Просмотры</div>
                            <div class="forecast-metric-value">@Model.Result.ExpectedViews</div>
                        </div>
                    </div>

                    <div class="forecast-metric-card">
                        <div class="forecast-metric-icon">📈</div>
                        <div>
                            <div class="forecast-metric-label">
                                ER
                                <span class="forecast-help"
                                      data-bs-toggle="tooltip"
                                      data-bs-placement="top"
                                      data-bs-title="ER — Engagement Rate, показатель вовлеченности. В системе считается как отношение реакций аудитории к просмотрам публикации.">
                                    ?
                                </span>
                            </div>
                            <div class="forecast-metric-value">@Model.Result.ExpectedERPercent.ToString("F1")%</div>
                        </div>
                    </div>
                </div>

                <div class="forecast-info-grid">
                    <div class="forecast-info-card factors">
                        <div class="forecast-info-head">
                            <div class="forecast-info-icon">✓</div>
                            <h3>Ключевые факторы</h3>
                        </div>

                        @if (Model.Result.KeyFactors.Any())
                        {
                            <ul class="forecast-list">
                                @foreach (var item in Model.Result.KeyFactors)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="forecast-empty-text">Ключевые факторы не выделены.</div>
                        }
                    </div>

                    <div class="forecast-info-card risks">
                        <div class="forecast-info-head">
                            <div class="forecast-info-icon">!</div>
                            <h3>Риски</h3>
                        </div>

                        @if (Model.Result.Risks.Any())
                        {
                            <ul class="forecast-list">
                                @foreach (var item in Model.Result.Risks)
                                {
                                    <li>@item</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="forecast-empty-text">Существенные риски не выделены.</div>
                        }
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Result.ComparisonWithAvg))
                {
                    <div class="forecast-comparison-card">
                        <div class="forecast-info-head">
                            <div class="forecast-info-icon">≈</div>
                            <h3>Сравнение со средним</h3>
                        </div>

                        <div class="forecast-comparison-text">
                            @Model.Result.ComparisonWithAvg
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="forecast-no-result">
                    <div class="forecast-no-result-icon">📊</div>
                    <div>
                        <div class="forecast-no-result-title">Результата пока нет</div>
                        <div class="forecast-no-result-text">
                            Запустите генерацию прогноза, чтобы получить ожидаемые метрики и оценку вовлеченности.
                        </div>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@await Html.PartialAsync("_LoadingOverlay", new RAGTEST.Models.LoadingOverlayViewModel
{
    OverlayId = "forecastLoadingOverlay",
    MessageId = "forecastLoadingMessage",
    Title = "Идёт генерация прогноза",
    InitialMessage = "Анализируем историю публикаций и формируем прогноз...",
    Hint = "Прогноз может занять некоторое время, так как используется локальная модель."
})

@{
    var forecastSubmitText = Model.Result != null ? "Сгенерировать заново" : "Сгенерировать прогноз";
}

@section Scripts {
    <script>
        initLoadingForm({
            formId: "forecastForm",
            submitButtonId: "submitBtn",
            overlayId: "forecastLoadingOverlay",
            messageId: "forecastLoadingMessage",
            submitText: @Html.Raw(JsonSerializer.Serialize(forecastSubmitText)),
            loadingButtonText: "Генерация...",
            messages: [
                "Анализируем историю публикаций сообщества...",
                "Извлекаем метрики вовлеченности за последние 30 дней...",
                "Формируем промпт для языковой модели...",
                "Оцениваем потенциальную реакцию аудитории...",
                "Подготавливаем итоговый прогноз...",
                "Почти готово..."
            ]
        });

                document.addEventListener("DOMContentLoaded", function () {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl, {
                    trigger: "hover focus",
                    container: "body"
                });
            });
        });
    </script>
}

@functions {
    private string NormalizeLevelText(string? level)
    {
        if (string.IsNullOrWhiteSpace(level))
            return "Прогноз не выполнен";

        var value = level.Trim().ToLowerInvariant();

        return value switch
        {
            "очень низкий" => "Очень низкий",
            "низкий" => "Низкий",
            "средний" => "Средний",
            "высокий" => "Высокий",
            "очень высокий" => "Очень высокий",
            _ => level.Trim()
        };
    }

    private string GetLevelCssClass(string? level)
    {
        if (string.IsNullOrWhiteSpace(level))
            return "pending";

        var value = level.Trim().ToLowerInvariant();

        if (value.Contains("очень низкий") || value == "низкий")
            return "danger";

        if (value == "средний")
            return "warning";

        if (value == "высокий" || value.Contains("очень высокий"))
            return "success";

        return "pending";
    }

    private string GetQualityCssClass(int score)
    {
        if (score < 40)
            return "danger";

        if (score < 70)
            return "warning";

        return "success";
    }
}