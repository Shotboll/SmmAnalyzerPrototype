@model RAGTEST.Models.RecommendationsPageModel
@{
    ViewData["Title"] = "Рекомендации по контенту";
}

<div class="container py-4">
    <div class="mb-4">
        <h1 class="fw-bold mb-2">Рекомендации по контенту</h1>
        <p class="text-muted mb-0">Практические советы по улучшению текста и повышению вовлеченности.</p>
    </div>

    <div class="row g-4">
        <!-- Левая колонка: параметры и форма -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">Параметры анализа</h4>

                    <div class="mb-3">
                        <div class="text-muted small">Сообщество</div>
                        <div class="fw-semibold">@Model.CommunityName</div>
                    </div>

                    <div class="mb-3">
                        <div class="text-muted small mb-2">Текст поста</div>
                        <div class="border rounded-4 p-3 bg-light" style="white-space: pre-wrap;">@Model.Text</div>
                    </div>

                    <form asp-action="Recommendations" method="post" id="recommendationsForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="postId" value="@Model.PostId" />

                        <div class="d-grid">
                            <button type="submit" class="btn btn-primary btn-lg rounded-3" id="submitBtn">
                                💡 Сгенерировать рекомендации
                            </button>
                        </div>
                    </form>

                    <div class="mt-3">
                        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="btn btn-outline-secondary">
                            Назад к посту
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Правая колонка: результат -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 rounded-4 h-100">
                <div class="card-body p-4">
                    <h4 class="card-title mb-4">Результат анализа</h4>

                    @if (Model.Result != null)
                    {
                        <div class="d-flex flex-column gap-4">
                            @if (Model.Result.TextImprovements.Any())
                            {
                                <div class="border rounded-4 p-3 bg-white">
                                    <h5 class="mb-3">✏️ Правки текста</h5>
                                    <ul class="mb-0 ps-3">@foreach(var i in Model.Result.TextImprovements){<li class="mb-2">@i</li>}</ul>
                                </div>
                            }
                            @if (Model.Result.StructuralChanges.Any())
                            {
                                <div class="border rounded-4 p-3 bg-white">
                                    <h5 class="mb-3">🏗️ Структурные изменения</h5>
                                    <ul class="mb-0 ps-3">@foreach(var i in Model.Result.StructuralChanges){<li class="mb-2">@i</li>}</ul>
                                </div>
                            }
                            @if (Model.Result.TopicIdeas.Any())
                            {
                                <div class="border rounded-4 p-3 bg-white">
                                    <h5 class="mb-3">💡 Темы для контента</h5>
                                    <div class="d-flex flex-wrap gap-2">
                                        @foreach (var t in Model.Result.TopicIdeas)
                                        {
                                            <span class="badge rounded-pill bg-light text-dark border">@t</span>
                                        }
                                    </div>
                                </div>
                            }
                            @if (Model.Result.EngagementBoosters.Any())
                            {
                                <div class="border rounded-4 p-3 bg-white">
                                    <h5 class="mb-3">🚀 Приёмы вовлеченности</h5>
                                    <ul class="mb-0 ps-3">@foreach(var b in Model.Result.EngagementBoosters){<li class="mb-2">@b</li>}</ul>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(Model.Result.OverallAdvice))
                            {
                                <div class="p-3 bg-light rounded-4 border">
                                    <div class="fw-semibold mb-2">📌 Общий совет</div>
                                    <div>@Model.Result.OverallAdvice</div>
                                </div>
                            }
                        </div>
                        }
                            else if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                        {
                        <div class="alert alert-danger">@Model.ErrorMessage</div>
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center h-100">
                                <div class="text-center text-muted py-5">
                                    <div class="fs-5 fw-semibold mb-2">Пока нет результата</div>
                                    <div>Нажмите кнопку запуска анализа.</div>
                                </div>
                            </div>
                        }
                </div>
            </div>
        </div>
    </div>
</div>

@await Html.PartialAsync("_LoadingOverlay", new RAGTEST.Models.LoadingOverlayViewModel
{
    OverlayId = "recommendationsLoadingOverlay",
    MessageId = "recommendationsLoadingMessage",
    Title = "Идёт генерация рекомендаций",
    InitialMessage = "Анализируем текст и формируем практические советы...",
    Hint = "Генерация может занять некоторое время, так как используется локальная модель."
})

@section Scripts {
    <script>
        initLoadingForm({
            formId: "recommendationsForm",
            submitButtonId: "submitBtn",
            overlayId: "recommendationsLoadingOverlay",
            messageId: "recommendationsLoadingMessage",
            submitText: "💡 Сгенерировать рекомендации",
            loadingButtonText: "Генерация...",
            messages: [
                "Анализируем текст публикации...",
                "Извлекаем параметры сообщества и историю публикаций...",
                "Формируем промпт для языковой модели...",
                "Генерируем правки текста и структурные изменения...",
                "Подбираем темы и приёмы повышения вовлеченности...",
                "Почти готово..."
            ]
        });
    </script>
}