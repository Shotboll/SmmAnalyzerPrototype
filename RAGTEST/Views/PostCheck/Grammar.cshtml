@model RAGTEST.Models.GrammarCheckPageModel

@{
    ViewData["Title"] = "Проверка на ошибки";

    var acceptedCount = Model.Cards?.Count ?? 0;
    var suspiciousCount = Model.SuspiciousCards?.Count ?? 0;
    var totalCount = acceptedCount + suspiciousCount;
}

<div class="grammar-page">
    <div class="grammar-page-header">
        <div>
            <h1 class="grammar-page-title">Проверка на ошибки</h1>
            <p class="grammar-page-subtitle">
                Система проверяет орфографию, пунктуацию и спорные языковые срабатывания в тексте поста.
            </p>
        </div>

        <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="grammar-back-top-btn">
            ← Назад к посту
        </a>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mb-4">@ViewBag.Error</div>
    }

    <div class="grammar-post-card">
        <div class="grammar-post-header">
            <div>
                <div class="grammar-label">Сообщество</div>
                <div class="grammar-community">@Model.CommunityName</div>
            </div>

            @if (Model.HasResult)
            {
                <div class="grammar-result-badge @(totalCount > 0 ? "has-errors" : "clean")">
                    @(totalCount > 0 ? $"Найдено замечаний: {totalCount}" : "Ошибок не найдено")
                </div>
            }
            else
            {
                <div class="grammar-result-badge pending">
                    Проверка не запускалась
                </div>
            }
        </div>

        <div class="grammar-label mb-2">Текст поста</div>
        <div class="grammar-post-text">@Model.Text</div>

        <form asp-action="Grammar" method="post" id="grammarForm" class="grammar-actions">
            @Html.AntiForgeryToken()
            <input asp-for="PostId" type="hidden" />

            <button type="submit" class="grammar-primary-btn" id="submitBtn">
                Проверить заново
            </button>

            <a asp-controller="Post" asp-action="Details" asp-route-id="@Model.PostId" class="grammar-secondary-btn">
                Назад к посту
            </a>
        </form>
    </div>

    @if (Model.HasResult)
    {
        <div class="grammar-summary-grid">
            <div class="grammar-summary-card accepted">
                <div class="grammar-summary-value">@acceptedCount</div>
                <div class="grammar-summary-title">Подтверждённые ошибки</div>
                <div class="grammar-summary-text">Срабатывания, которые система считает достаточно надёжными.</div>
            </div>

            <div class="grammar-summary-card suspicious">
                <div class="grammar-summary-value">@suspiciousCount</div>
                <div class="grammar-summary-title">Сомнительные случаи</div>
                <div class="grammar-summary-text">Фрагменты, которые лучше проверить вручную.</div>
            </div>

            <div class="grammar-summary-card total">
                <div class="grammar-summary-value">@totalCount</div>
                <div class="grammar-summary-title">Всего замечаний</div>
                <div class="grammar-summary-text">Общее количество найденных и показанных пользователю мест.</div>
            </div>
        </div>

        <div class="grammar-results-grid">
            <section class="grammar-result-section">
                <div class="grammar-section-head">
                    <div>
                        <h2>Подтверждённые ошибки</h2>
                        <p>Ошибки, которые прошли фильтрацию и отображаются как основной результат.</p>
                    </div>

                    <span class="grammar-count-chip accepted">@acceptedCount</span>
                </div>

                @if (Model.Cards.Any())
                {
                    <div class="grammar-error-list">
                        @for (int i = 0; i < Model.Cards.Count; i++)
                        {
                            var item = Model.Cards[i];

                            <article class="grammar-error-card accepted">
                                <div class="grammar-error-top">
                                    <div>
                                        <div class="grammar-error-label">Фрагмент</div>
                                        <div class="grammar-error-fragment">@item.Original</div>
                                    </div>

                                    <span class="grammar-error-status accepted">Ошибка</span>
                                </div>

                                <div class="grammar-error-body">
                                    @if (!string.IsNullOrWhiteSpace(item.Correction))
                                    {
                                        <div class="grammar-error-row">
                                            <span>Исправление</span>
                                            <strong>@item.Correction</strong>
                                        </div>
                                    }

                                    @{
                                        var categoryText = GetGrammarCategoryText(item.Type, item.Hint);
                                    }

                                    <div class="grammar-error-row">
                                        <span>Категория</span>
                                        <strong>@categoryText</strong>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Hint))
                                    {
                                        <div class="grammar-error-comment">
                                            @item.Hint
                                        </div>
                                    }
                                </div>

                                <div class="grammar-error-footer">
                                    <button type="button"
                                            class="grammar-explain-btn explain-btn"
                                            data-fragment="@item.Original"
                                            data-suggestion="@item.Correction"
                                            data-type="@item.Type"
                                            data-message="@item.Hint"
                                            data-sentence="@item.Sentence"
                                            data-target="accepted-explanation-@i">
                                        Получить пояснение
                                    </button>
                                </div>

                                <div id="accepted-explanation-@i" class="grammar-explanation"></div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="grammar-empty-result">
                        <div class="grammar-empty-icon">✓</div>
                        <div>
                            <div class="grammar-empty-title">Подтверждённых ошибок нет</div>
                            <div class="grammar-empty-text">Основная проверка не выявила надёжных ошибок.</div>
                        </div>
                    </div>
                }
            </section>

            <section class="grammar-result-section">
                <div class="grammar-section-head">
                    <div>
                        <h2>Сомнительные случаи</h2>
                        <p>Места, которые могут быть ложными срабатываниями и требуют ручной проверки.</p>
                    </div>

                    <span class="grammar-count-chip suspicious">@suspiciousCount</span>
                </div>

                @if (Model.SuspiciousCards.Any())
                {
                    <div class="grammar-error-list">
                        @for (int i = 0; i < Model.SuspiciousCards.Count; i++)
                        {
                            var item = Model.SuspiciousCards[i];

                            <article class="grammar-error-card suspicious">
                                <div class="grammar-error-top">
                                    <div>
                                        <div class="grammar-error-label">Фрагмент</div>
                                        <div class="grammar-error-fragment">@item.Original</div>
                                    </div>

                                    <span class="grammar-error-status suspicious">Проверить</span>
                                </div>

                                <div class="grammar-error-body">
                                    @if (!string.IsNullOrWhiteSpace(item.Correction))
                                    {
                                        <div class="grammar-error-row">
                                            <span>Возможное исправление</span>
                                            <strong>@item.Correction</strong>
                                        </div>
                                    }

                                    @{
                                        var categoryText = GetGrammarCategoryText(item.Type, item.Hint);
                                    }

                                    <div class="grammar-error-row">
                                        <span>Категория</span>
                                        <strong>@categoryText</strong>
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(item.Hint))
                                    {
                                        <div class="grammar-error-comment">
                                            @item.Hint
                                        </div>
                                    }
                                </div>

                                <div class="grammar-suspicious-note">
                                    Сомнительное срабатывание: решение лучше принять вручную.
                                </div>
                            </article>
                        }
                    </div>
                }
                else
                {
                    <div class="grammar-empty-result">
                        <div class="grammar-empty-icon">✓</div>
                        <div>
                            <div class="grammar-empty-title">Сомнительных случаев нет</div>
                            <div class="grammar-empty-text">Фильтр не нашёл спорных срабатываний.</div>
                        </div>
                    </div>
                }
            </section>
        </div>
    }
    else
    {
        <div class="grammar-no-result-card">
            <div class="grammar-empty-icon">↻</div>
            <div>
                <div class="grammar-empty-title">Результатов пока нет</div>
                <div class="grammar-empty-text">Запустите проверку, чтобы увидеть найденные ошибки и сомнительные случаи.</div>
            </div>
        </div>
    }
</div>

@await Html.PartialAsync("_LoadingOverlay", new RAGTEST.Models.LoadingOverlayViewModel
{
    OverlayId = "grammarLoadingOverlay",
    MessageId = "grammarLoadingMessage",
    Title = "Идёт проверка текста",
    InitialMessage = "Выполняется анализ орфографии и пунктуации...",
    Hint = "Обычно проверка выполняется быстро, так как для базовой проверки используется LanguageTool."
})

@section Scripts {
    <script>
        initLoadingForm({
            formId: "grammarForm",
            submitButtonId: "submitBtn",
            overlayId: "grammarLoadingOverlay",
            messageId: "grammarLoadingMessage",
            submitText: "Проверить заново",
            loadingButtonText: "Идёт проверка...",
            messages: [
                "Выполняется анализ орфографии и пунктуации...",
                "Проверяются возможные ошибки в тексте...",
                "Фильтруются ложные срабатывания...",
                "Формируется список найденных ошибок...",
                "Почти готово..."
            ]
        });

        document.addEventListener("DOMContentLoaded", function () {
            const buttons = document.querySelectorAll(".explain-btn");

            buttons.forEach(button => {
                button.addEventListener("click", async function () {
                    const targetId = this.dataset.target;
                    const target = document.getElementById(targetId);

                    if (!target) {
                        return;
                    }

                    this.disabled = true;
                    const originalText = this.textContent;
                    this.textContent = "Загрузка...";

                    target.innerHTML = `
                        <div class="grammar-explanation-box loading">
                            <div class="grammar-explanation-title">Пояснение</div>
                            <div class="grammar-explanation-text">Запрашиваем пояснение у модели...</div>
                        </div>
                    `;

                    try {
                        const response = await fetch("/PostCheck/ExplainGrammarItemProxy", {
                            method: "POST",
                            headers: {
                                "Content-Type": "application/json"
                            },
                            body: JSON.stringify({
                                fragment: this.dataset.fragment || "",
                                suggestion: this.dataset.suggestion || "",
                                type: this.dataset.type || "",
                                message: this.dataset.message || "",
                                sentence: this.dataset.sentence || ""
                            })
                        });

                        if (!response.ok) {
                            throw new Error("Ошибка запроса");
                        }

                        const data = await response.json();

                        target.innerHTML = `
                            <div class="grammar-explanation-box">
                                <div class="grammar-explanation-title">Пояснение</div>
                                <div class="grammar-explanation-text">${escapeHtml(data.explanation || "")}</div>
                                <div class="grammar-explanation-advice">
                                    <strong>Совет:</strong> ${escapeHtml(data.hint || "")}
                                </div>
                            </div>
                        `;
                    } catch (error) {
                        target.innerHTML = `
                            <div class="alert alert-danger mb-0">
                                Не удалось получить пояснение.
                            </div>
                        `;
                    } finally {
                        this.disabled = false;
                        this.textContent = originalText;
                    }
                });
            });

            function escapeHtml(text) {
                const div = document.createElement("div");
                div.textContent = text;
                return div.innerHTML;
            }
        });
    </script>
}

@functions {
    private string GetGrammarCategoryText(string? type, string? message)
    {
        var rawType = type?.Trim().ToLowerInvariant() ?? string.Empty;
        var rawMessage = message?.Trim().ToLowerInvariant() ?? string.Empty;

        if (rawMessage.Contains("запята") || rawMessage.Contains("пунктуац"))
            return "Пунктуация";

        if (rawMessage.Contains("дефис"))
            return "Дефисное написание";

        if (rawMessage.Contains("слитно"))
            return "Слитное написание";

        if (rawMessage.Contains("раздельно"))
            return "Раздельное написание";

        if (rawMessage.Contains("пробел"))
            return "Пробелы";

        if (rawMessage.Contains("орфограф") || rawType.Contains("misspelling"))
            return "Орфография";

        if (rawMessage.Contains("регистр") || rawMessage.Contains("заглавн") || rawMessage.Contains("строчн"))
            return "Регистр букв";

        if (rawMessage.Contains("повтор"))
            return "Повтор слова";

        if (rawType.Contains("uncategorized"))
            return "Языковое замечание";

        return "Языковое замечание";
    }
}