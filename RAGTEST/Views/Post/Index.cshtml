@model List<SmmAnalyzerPrototype.Data.Models.DTO.Post.PostListItemDto>

@{
    ViewData["Title"] = "Посты";
}

<div class="posts-page">
    <div class="posts-page-header">
        <div>
            <h1 class="posts-page-title">Посты</h1>
            <p class="posts-page-subtitle">Список сохранённых публикаций и состояние выполненных проверок.</p>
        </div>

        <a asp-action="Create" class="posts-create-btn">
            <span>＋</span>
            <span>Создать пост</span>
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="posts-empty-card">
            <div class="posts-empty-icon">📝</div>
            <h3>Постов пока нет</h3>
            <p>Создайте первую публикацию, чтобы запустить проверку текста и анализ контента.</p>

            <a asp-action="Create" class="posts-create-btn">
                <span>＋</span>
                <span>Создать пост</span>
            </a>
        </div>
    }
    else
    {
        <div class="posts-list">
            @foreach (var post in Model)
            {
                var checksCount = 0;

                if (post.GrammarChecked) checksCount++;
                if (post.StyleChecked) checksCount++;
                if (post.RegulationChecked) checksCount++;
                if (post.ForecastChecked) checksCount++;
                if (post.RecommendationsChecked) checksCount++;

                var progressPercent = checksCount * 20;

                <article class="post-list-card">
                    <div class="post-list-main">
                        <div class="post-date-box">
                            <div class="post-date-day">@post.CreatedAt.ToLocalTime().ToString("dd.MM")</div>
                            <div class="post-date-year">@post.CreatedAt.ToLocalTime().ToString("yyyy")</div>
                            <div class="post-date-time">@post.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                        </div>

                        <div class="post-list-content">
                            <div class="post-card-topline">
                                <span class="post-community">@post.CommunityName</span>
                                <span class="post-status-chip @GetStatusCssClass(post.StatusText)">
                                    @(string.IsNullOrWhiteSpace(post.StatusText) ? "Без статуса" : post.StatusText)
                                </span>
                            </div>

                            <div class="post-preview-text">
                                @post.TextPreview
                            </div>

                            <div class="post-progress-row">
                                <div class="post-progress-info">
                                    Проверки: <strong>@checksCount из 5</strong>
                                </div>

                                <div class="post-progress">
                                    <div class="post-progress-fill" style="width: @progressPercent%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="post-checks-box">
                        <div class="post-checks-grid">
                            <span class="post-check-chip @(post.GrammarChecked ? "done" : "pending")">
                                <span class="post-check-dot"></span>
                                Ошибки
                            </span>

                            <span class="post-check-chip @(post.StyleChecked ? "done" : "pending")">
                                <span class="post-check-dot"></span>
                                Стиль
                            </span>

                            <span class="post-check-chip @(post.RegulationChecked ? "done" : "pending")">
                                <span class="post-check-dot"></span>
                                Регламенты
                            </span>

                            <span class="post-check-chip @(post.ForecastChecked ? "done" : "pending")">
                                <span class="post-check-dot"></span>
                                Прогноз
                            </span>

                            <span class="post-check-chip @(post.RecommendationsChecked ? "done" : "pending")">
                                <span class="post-check-dot"></span>
                                Рекомендации
                            </span>
                        </div>

                        <a asp-action="Details" asp-route-id="@post.Id" class="post-open-btn">
                            Открыть
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div>

@functions {
    private string GetStatusCssClass(string? statusText)
    {
        if (string.IsNullOrWhiteSpace(statusText))
            return "status-muted";

        if (statusText.Contains("Полностью", StringComparison.OrdinalIgnoreCase))
            return "status-full";

        if (statusText.Contains("Частично", StringComparison.OrdinalIgnoreCase))
            return "status-partial";

        if (statusText.Contains("Черновик", StringComparison.OrdinalIgnoreCase))
            return "status-draft";

        return "status-muted";
    }
}