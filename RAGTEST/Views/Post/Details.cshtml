@model SmmAnalyzerPrototype.Data.Models.DTO.Post.PostDetailsDto
@using System.Net
@using System.Text
@using SmmAnalyzerPrototype.Data.Models.DTO.Post

@{
    ViewData["Title"] = "Детали поста";
}

@functions {
    private string BuildHighlightedText(string text, List<GrammarErrorDto>? grammarErrors, List<ViolationDto>? violations)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;

        var highlights = new List<TextHighlightItem>();

        if (grammarErrors != null)
        {
            foreach (var error in grammarErrors)
            {
                if (error.Offset < 0 || error.Offset >= text.Length)
                    continue;

                var length = error.Length > 0 ? error.Length : (!string.IsNullOrWhiteSpace(error.Fragment) ? error.Fragment.Length : 1);

                if (length <= 0)
                    continue;

                if (error.Offset + length > text.Length)
                    length = text.Length - error.Offset;

                highlights.Add(new TextHighlightItem
                {
                    Offset = error.Offset,
                    Length = length,
                    CssClass = error.IsSuspicious ? "text-warning-highlight" : "text-error-highlight",
                    Title = BuildGrammarTitle(error)
                });
            }
        }

        if (violations != null)
        {
            foreach (var violation in violations)
            {
                if (string.IsNullOrWhiteSpace(violation.MatchedText))
                    continue;

                var index = text.IndexOf(violation.MatchedText, StringComparison.OrdinalIgnoreCase);

                if (index < 0)
                    continue;

                highlights.Add(new TextHighlightItem
                {
                    Offset = index,
                    Length = violation.MatchedText.Length,
                    CssClass = "text-regulation-highlight",
                    Title = BuildViolationTitle(violation)
                });
            }
        }

        var validHighlights = highlights
            .Where(x => x.Offset >= 0 && x.Offset < text.Length && x.Length > 0)
            .OrderBy(x => x.Offset)
            .ToList();

        var sb = new StringBuilder();
        int currentIndex = 0;

        foreach (var highlight in validHighlights)
        {
            if (highlight.Offset < currentIndex)
                continue;

            if (highlight.Offset > currentIndex)
            {
                var before = text.Substring(currentIndex, highlight.Offset - currentIndex);
                sb.Append(WebUtility.HtmlEncode(before));
            }

            var length = Math.Min(highlight.Length, text.Length - highlight.Offset);
            var fragment = text.Substring(highlight.Offset, length);

            var tooltipText = WebUtility.HtmlEncode(highlight.Title).Replace("\n", "<br>");

            sb.Append($"<span class=\"{highlight.CssClass}\" data-bs-toggle=\"tooltip\" data-bs-html=\"true\" data-bs-placement=\"top\" data-bs-custom-class=\"post-error-tooltip\" data-bs-title=\"{tooltipText}\">");
            sb.Append(WebUtility.HtmlEncode(fragment));
            sb.Append("</span>");

            currentIndex = highlight.Offset + length;
        }

        if (currentIndex < text.Length)
        {
            sb.Append(WebUtility.HtmlEncode(text.Substring(currentIndex)));
        }

        return sb.ToString().Replace("\r\n", "<br />").Replace("\n", "<br />");
    }

    private string BuildGrammarTitle(GrammarErrorDto error)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(error.Message))
            parts.Add(error.Message);

        if (!string.IsNullOrWhiteSpace(error.Suggestion))
            parts.Add($"Исправление: {error.Suggestion}");

        if (error.IsSuspicious)
            parts.Add("Это сомнительное срабатывание, проверьте вручную.");

        return string.Join("\n", parts);
    }

    private string BuildViolationTitle(ViolationDto violation)
    {
        var parts = new List<string>();

        if (!string.IsNullOrWhiteSpace(violation.RuleShort))
            parts.Add(violation.RuleShort);

        if (!string.IsNullOrWhiteSpace(violation.Explanation))
            parts.Add(violation.Explanation);

        return string.Join("\n", parts);
    }

    private class TextHighlightItem
    {
        public int Offset { get; set; }
        public int Length { get; set; }
        public string CssClass { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
    }
}

<div class="container py-4">
    <div class="details-page-header">
        <div>
            <h1 class="details-page-title">Детали поста</h1>

            <div class="details-page-meta">
                Сообщество: <strong>@Model.CommunityName</strong>
                @if (!string.IsNullOrWhiteSpace(Model.AuthorLogin))
                {
                    <span> · Автор: @Model.AuthorLogin</span>
                }
                <span> · Статус: @Model.StatusText</span>
            </div>
        </div>

        <div class="details-actions">
            <a asp-controller="Post" asp-action="Edit" asp-route-id="@Model.Id" class="details-action-btn details-action-edit">
                <span class="details-action-icon">✏️</span>
                <span>Редактировать</span>
            </a>

            <a asp-controller="Post" asp-action="Index" class="details-action-btn details-action-back">
                <span class="details-action-icon">←</span>
                <span>К списку</span>
            </a>

            <form asp-controller="Post" asp-action="Delete" asp-route-id="@Model.Id" method="post"
                  onsubmit="return confirm('Удалить этот пост? Все результаты проверок по нему тоже будут удалены.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="details-action-btn details-action-delete">
                    <span class="details-action-icon">🗑️</span>
                    <span>Удалить</span>
                </button>
            </form>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="mb-0">Текст поста</h4>

                        @if (Model.GrammarCheckedAt.HasValue)
                        {
                            <span class="badge bg-light text-dark border">
                                Ошибок: @(Model.GrammarErrors?.Count ?? 0)
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary">
                                Грамматика не проверена
                            </span>
                        }
                    </div>

                    <div class="post-text-box">
                        @Html.Raw(BuildHighlightedText(Model.Text, Model.GrammarErrors, Model.RegulationViolations))
                    </div>

                    <div class="post-check-panel">
                        <div class="post-check-panel-title">Запустить проверку</div>

                        <div class="post-check-actions">
                            <a asp-controller="PostCheck" asp-action="Grammar" asp-route-postId="@Model.Id" class="post-check-btn">
                                <span>✓</span>
                                <span>Грамматика</span>
                            </a>

                            <a asp-controller="PostCheck" asp-action="Style" asp-route-postId="@Model.Id" class="post-check-btn">
                                <span>🎯</span>
                                <span>Стиль</span>
                            </a>

                            <a asp-controller="PostCheck" asp-action="Regulations" asp-route-postId="@Model.Id" class="post-check-btn">
                                <span>📄</span>
                                <span>Регламенты</span>
                            </a>

                            <a asp-controller="PostCheck" asp-action="Forecast" asp-route-postId="@Model.Id" class="post-check-btn">
                                <span>📊</span>
                                <span>Прогноз</span>
                            </a>

                            <a asp-controller="PostCheck" asp-action="Recommendations" asp-route-postId="@Model.Id" class="post-check-btn">
                                <span>💡</span>
                                <span>Рекомендации</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            @if (Model.GrammarErrors != null && Model.GrammarErrors.Any())
            {
                <div class="card shadow-sm border-0 rounded-4 mt-4">
                    <div class="card-body p-4">
                        <h4 class="mb-3">Замечания по чистоте текста</h4>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var error in Model.GrammarErrors.OrderBy(x => x.Offset))
                            {
                                <div class="border rounded-4 p-3">
                                    <div class="d-flex justify-content-between gap-3">
                                        <div>
                                            <div class="fw-semibold mb-1">
                                                @error.Fragment
                                            </div>

                                            <div class="text-muted small mb-2">
                                                @error.Message
                                            </div>

                                            @if (!string.IsNullOrWhiteSpace(error.Suggestion))
                                            {
                                                <div>
                                                    <span class="text-muted">Вариант исправления:</span>
                                                    <strong>@error.Suggestion</strong>
                                                </div>
                                            }
                                        </div>

                                        @if (error.IsSuspicious)
                                        {
                                            <span class="badge bg-warning-subtle text-warning align-self-start">
                                                Сомнительно
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger-subtle text-danger align-self-start">
                                                Ошибка
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

            @if (Model.RegulationViolations != null && Model.RegulationViolations.Any())
            {
                <div class="card shadow-sm border-0 rounded-4 mt-4">
                    <div class="card-body p-4">
                        <h4 class="mb-3">Нарушения регламентов</h4>

                        <div class="d-flex flex-column gap-3">
                            @foreach (var violation in Model.RegulationViolations)
                            {
                                <div class="border rounded-4 p-3">
                                    <div class="fw-semibold mb-1 text-danger">
                                        @violation.RuleShort
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(violation.MatchedText))
                                    {
                                        <div class="mb-2">
                                            <span class="text-muted">Фрагмент:</span>
                                            <strong>@violation.MatchedText</strong>
                                        </div>
                                    }

                                    <div class="text-muted">
                                        @violation.Explanation
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="d-flex flex-column gap-3">
                <div class="check-summary-card">
                    <h5 class="mb-3">Сводка проверок</h5>

                    <div class="mb-2">
                        <span class="check-status-dot @(Model.GrammarCheckedAt.HasValue ? "status-success" : "status-muted")"></span>
                        Грамматика
                    </div>

                    <div class="mb-2">
                        <span class="check-status-dot @(Model.StyleCheckedAt.HasValue ? "status-success" : "status-muted")"></span>
                        Стиль
                    </div>

                    <div class="mb-2">
                        <span class="check-status-dot @(Model.RegulationCheckedAt.HasValue ? ((Model.HasRegulationViolations ?? false) ? "status-danger" : "status-success") : "status-muted")"></span>
                        Регламенты
                    </div>

                    <div class="mb-2">
                        <span class="check-status-dot @(Model.ForecastCheckedAt.HasValue ? "status-success" : "status-muted")"></span>
                        Прогноз вовлеченности
                    </div>

                    <div>
                        <span class="check-status-dot @(Model.RecommendationsCheckedAt.HasValue ? "status-success" : "status-muted")"></span>
                        Рекомендации
                    </div>
                </div>

                @if (Model.StyleCheckedAt.HasValue)
                {
                    <div class="check-summary-card">
                        <h5 class="mb-3">Стиль</h5>

                        <div class="fw-semibold mb-2">
                            @Model.StyleAssessment
                        </div>

                        <div class="text-muted">
                            @Model.StyleSummary
                        </div>
                    </div>
                }

                @if (Model.RegulationCheckedAt.HasValue)
                {
                    <div class="check-summary-card">
                        <h5 class="mb-3">Регламенты</h5>

                        @if (Model.HasRegulationViolations ?? false)
                        {
                            <div class="alert alert-danger mb-2">
                                Найдены нарушения: @(Model.RegulationViolations?.Count ?? 0)
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success mb-2">
                                Нарушения не найдены
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.RegulationComment))
                        {
                            <div class="text-muted">
                                @Model.RegulationComment
                            </div>
                        }
                    </div>
                }

                @if (Model.ForecastCheckedAt.HasValue)
                {
                    <div class="check-summary-card">
                        <h5 class="mb-3">Прогноз</h5>

                        <div class="mb-3">
                            <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                @Model.ForecastLevel
                            </span>
                        </div>

                        <div class="row g-2">
                            <div class="col-6">
                                <div class="mini-metric-card">
                                    <div class="text-muted small">Качество</div>
                                    <div class="fw-bold">@Model.ForecastQualityScore</div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="mini-metric-card">
                                    <div class="text-muted small">ER</div>
                                    <div class="fw-bold">@Model.ForecastERPercent.ToString("F1")%</div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="mini-metric-card">
                                    <div class="text-muted small">Лайки</div>
                                    <div class="fw-bold">@Model.ForecastLikes</div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="mini-metric-card">
                                    <div class="text-muted small">Просмотры</div>
                                    <div class="fw-bold">@Model.ForecastViews</div>
                                </div>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.RecommendationsCheckedAt.HasValue)
                {
                    <div class="check-summary-card">
                        <h5 class="mb-3">Рекомендации</h5>

                        @if (Model.RecommendationsText != null && Model.RecommendationsText.Any())
                        {
                            <div class="mb-3">
                                <div class="fw-semibold mb-2">Правки текста</div>
                                <ul class="mb-0 ps-3">
                                    @foreach (var item in Model.RecommendationsText.Take(3))
                                    {
                                        <li class="mb-2">@item</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.RecommendationsTopics != null && Model.RecommendationsTopics.Any())
                        {
                            <div class="mb-3">
                                <div class="fw-semibold mb-2">Темы</div>
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var topic in Model.RecommendationsTopics.Take(3))
                                    {
                                        <span class="badge bg-light text-dark border recommendation-topic-badge">@topic</span>
                                    }
                                </div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.RecommendationsAdvice))
                        {
                            <div class="p-3 bg-light rounded-4 recommendation-advice">
                                @Model.RecommendationsAdvice
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tooltipTriggerList = document.querySelectorAll('[data-bs-toggle="tooltip"]');

            tooltipTriggerList.forEach(function (tooltipTriggerEl) {
                new bootstrap.Tooltip(tooltipTriggerEl, {
                    trigger: "hover focus",
                    container: "body"
                });
            });
        });
    </script>
}